// Niri + Catppuccin Mocha. Consulte ~/dotfiles/README.md.
input {
    keyboard {
        xkb {
            layout "br,us"
            options "grp:win_space_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    focus-follows-mouse max-scroll-amount="0%"
}
output "eDP-1" {
    mode "1920x1080@60"
    scale 1
}
layout {
    gaps 10
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
    }
    border { off; }
    shadow {
        off
        softness 22
        spread 0
        offset x=0 y=5
        color "#00000055"
    }
    background-color "#1e1e2e"
}
prefer-no-csd
animations {
    slowdown 0.9
    window-open { duration-ms 160; curve "ease-out-cubic"; }
    window-close { duration-ms 140; curve "ease-out-quad"; }
}
blur { passes 2; offset 2; }
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
}
window-rule {
    match is-floating=true
    shadow { on; }
}
window-rule {
    match app-id=r#"^(org\.gnome\.Calculator|org\.gnome\.Settings|org\.pulseaudio\.pavucontrol|blueman-manager|nm-connection-editor)$"#
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 650; }
    default-floating-position x=0 y=0 relative-to="top"
}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    default-column-width { fixed 400; }
    default-window-height { fixed 550; }
}
window-rule {
    match app-id=r#"^org\.gnome\.Settings$"#
    open-maximized false
}
window-rule {
    match app-id=r#"^(org\.pulseaudio\.pavucontrol|blueman-manager|nm-connection-editor)$"#
    default-column-width { fixed 750; }
    default-window-height { fixed 560; }
}
window-rule {
    match app-id="^Alacritty$"
    background-effect { xray true; blur true; }
}
layer-rule {
    match namespace="^launcher$"
    background-effect { xray true; blur true; }
}
// Rice V3: the on-demand settings window uses its own dark GTK stylesheet.
window-rule {
    match app-id="^org[.]niri[.]Rice$"
    open-floating true
    open-maximized false
    default-column-width { fixed 960; }
    default-window-height { fixed 700; }
}
layer-rule {
    match namespace="^niri-calendar$"
    geometry-corner-radius 16
    shadow { on; softness 20; spread 0; offset x=0 y=4; color "#00000055"; }
}
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
screenshot-path "~/Imagens/Capturas/Niri-%Y-%m-%d-%H-%M-%S.png"
spawn-at-startup "systemctl" "--user" "start" "niri-rice.target"
binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "sh" "-c" "exec alacritty --config-file ~/.config/alacritty/niri.toml"; }
    Mod+D hotkey-overlay-title="Aplicativos" { spawn "sh" "-c" "exec fuzzel --config ~/.config/niri/fuzzel.ini"; }
    Mod+E hotkey-overlay-title="Arquivos" { spawn "nautilus" "--new-window"; }
    Mod+B hotkey-overlay-title="Monitor de recursos" { spawn "sh" "-c" "exec alacritty --config-file ~/.config/alacritty/niri.toml -e btop"; }
    Mod+Q { close-window; }
    Alt+F4 { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-window-to-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down; }
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+Shift+1 { move-window-to-workspace "1"; }
    Mod+Shift+2 { move-window-to-workspace "2"; }
    Mod+Shift+3 { move-window-to-workspace "3"; }
    Mod+Shift+4 { move-window-to-workspace "4"; }
    Mod+Shift+5 { move-window-to-workspace "5"; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Comma hotkey-overlay-title="Configurações" { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub"; }
    Mod+Shift+W hotkey-overlay-title="Escolher wallpaper" { spawn "sh" "-c" "exec ~/.config/niri/scripts/wallpaper-manager choose"; }
    Mod+Shift+D hotkey-overlay-title="Mostrar ou ocultar dock" { spawn "sh" "-c" "exec ~/.config/niri/scripts/dock-mode toggle"; }
    Alt+Tab hotkey-overlay-title="Alternador de janelas" { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub switcher"; }
    Alt+Shift+Tab { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub switcher-back"; }
    Mod+Ctrl+D hotkey-overlay-title="Spotlight" { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub spotlight"; }
    Mod+Shift+C hotkey-overlay-title="Histórico de cópia" { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub clipboard"; }
    Mod+Ctrl+Comma hotkey-overlay-title="Central de controle" { spawn "sh" "-c" "exec ~/.config/niri/scripts/settings-hub control"; }
    Mod+O { toggle-overview; }
    Mod+Tab { focus-workspace-previous; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Super+L hotkey-overlay-title="Bloquear tela" { spawn "sh" "-c" "exec ~/.config/niri/scripts/lock"; }
    Super+Alt+L hotkey-overlay-title="Bloquear tela" { spawn "sh" "-c" "exec ~/.config/niri/scripts/lock"; }
    Mod+N { spawn "sh" "-c" "exec ~/.config/niri/scripts/notifications dismiss"; }
    Mod+Shift+N { spawn "sh" "-c" "exec ~/.config/niri/scripts/notifications dnd"; }
    Mod+Ctrl+N hotkey-overlay-title="Histórico de notificações" { spawn "sh" "-c" "exec ~/.config/niri/scripts/notifications open"; }
    Super+Shift+S hotkey-overlay-title="Capturar tela" { screenshot; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "--min-value=1" "set" "5%-"; }
}
