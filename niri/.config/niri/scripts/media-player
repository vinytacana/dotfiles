#!/usr/bin/python3
"""Raise the MPRIS player selected by playerctld, without launching another instance."""
import sys
sys.dont_write_bytecode=True
import gi
gi.require_version('Gio','2.0')
from gi.repository import Gio,GLib
from rice_common import focus

try:
    root=Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION,Gio.DBusProxyFlags.NONE,None,
        'org.mpris.MediaPlayer2.playerctld','/org/mpris/MediaPlayer2','org.mpris.MediaPlayer2',None)
    entry=root.get_cached_property('DesktopEntry')
    identity=entry.unpack()+'.desktop' if entry else None
    # Desktop metadata provides StartupWMClass for native and Flatpak players.
    if identity and focus(identity):sys.exit(0)
    root.call_sync('Raise',None,Gio.DBusCallFlags.NONE,3000,None)
except (GLib.Error,OSError,ValueError) as error:
    sys.exit('media-player: '+str(error))
