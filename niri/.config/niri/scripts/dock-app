#!/usr/bin/python3
"""Desktop-file based dock: status, focus-or-launch, declared desktop actions."""
import json
import sys
sys.dont_write_bytecode = True
from rice_common import desktop, matches, windows, open_or_focus, launch

try:
    identity, operation = sys.argv[1:3]
    app = desktop(identity)
    if not app:
        raise ValueError(f'Arquivo desktop ausente: {identity}')
    if operation == 'status':
        found = matches(identity, windows())
        print(json.dumps({'text': ' ', 'tooltip': app.get_display_name() +
                          (f' · {len(found)} janela(s)' if found else ' · Abrir'),
                          'class': ['running' if found else 'stopped'] +
                          (['focused'] if any(w.get('is_focused') for w in found) else [])}, ensure_ascii=False))
    elif operation == 'open':
        open_or_focus(identity)
    elif operation == 'launch':
        launch(identity, sys.argv[3] if len(sys.argv) > 3 else None)
    else:
        raise ValueError('Use status, open ou launch [ação desktop]')
except Exception as error:
    print(f'dock-app: {error}', file=sys.stderr)
    if len(sys.argv) > 2 and sys.argv[2] == 'status':
        print(json.dumps({'text': '!', 'tooltip': str(error), 'class': 'unavailable'}))
    sys.exit(1)
