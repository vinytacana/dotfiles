#!/usr/bin/python3
"""One label: idle OR track, using playerctld's selected real MPRIS owner.

Reuses the existing Waybar child; no polling or playerctl subprocesses.
Transport snapshots are refreshed by a Waybar realtime signal, only on change.
"""
import json
import os
from pathlib import Path
import signal
import sys
sys.dont_write_bytecode = True
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib, GLibUnix

NAME = 'org.mpris.MediaPlayer2.playerctld'
PATH = '/org/mpris/MediaPlayer2'
PLAYER = 'org.mpris.MediaPlayer2.Player'
FLAGS = Gio.DBusProxyFlags.DO_NOT_AUTO_START


def target_path():
    return Path(os.environ['XDG_RUNTIME_DIR'])/'niri-rice/media-target.json'


def clean(value):
    return ' '.join(value.split()) if isinstance(value, str) else ''


class MediaState:
    """Selection epochs reject late replies/signals from a departed player."""
    def __init__(self):
        self.service = False
        self.name = None
        self.owner = None
        self.properties = {}
        self.epoch = 0
        self.loading = False

    def select(self, service, names):
        name = next((n for n in names if isinstance(n, str) and
                     n.startswith('org.mpris.MediaPlayer2.') and n != NAME), None) if service else None
        if (bool(service), name) != (self.service, self.name):
            self.epoch += 1
            self.service, self.name = bool(service), name
            self.owner, self.properties = None, {}
            self.loading = bool(name)
        return self.epoch

    def update(self, epoch, owner, values, invalidated=()):
        if epoch != self.epoch or not self.name:
            return False
        if owner != self.owner:
            self.properties = {}
        self.owner = owner
        self.loading = False
        if not owner:
            self.properties = {}
        else:
            for key in invalidated:
                self.properties.pop(key, None)
            self.properties.update(values)
        return True

    def target(self):
        return {'name': self.name, 'owner': self.owner,
                'control': self.properties.get('CanControl') is True}

    def controls(self):
        props = self.properties
        metadata = props.get('Metadata')
        ready = bool(self.service and self.owner and isinstance(metadata, dict) and
                     clean(metadata.get('xesam:title')) and props.get('CanControl') is True and
                     props.get('PlaybackStatus') in ['Playing', 'Paused', 'Stopped'])
        playing = props.get('PlaybackStatus') == 'Playing'
        result = {}
        for name, capability, icon, tooltip in [
            ('previous', 'CanGoPrevious', '󰒮', 'Faixa anterior'),
            ('play', 'CanPause' if playing else 'CanPlay', '󰏤' if playing else '󰐊', 'Pausar' if playing else 'Reproduzir'),
            ('next', 'CanGoNext', '󰒭', 'Próxima faixa')]:
            result[name] = {'text': icon if ready and props.get(capability) is True else '',
                            'tooltip': tooltip, 'class': name}
        visible = [name for name, value in result.items() if value['text']]
        if visible: result[visible[-1]]['class'] = [visible[-1], 'last']
        return result

    def output(self):
        icon = '<span foreground="#1db954" size="large"></span>'
        if not self.service:
            text, state = 'Mídia indisponível', 'unavailable'
            tip = 'Serviço MPRIS indisponível. Clique para abrir/focar Spotify.'
        elif not self.name:
            text, state = 'Nada tocando', 'idle'
            tip = 'Nenhum player MPRIS disponível. Clique para abrir/focar Spotify.'
        else:
            short = self.name.removeprefix('org.mpris.MediaPlayer2.')
            if 'spotify' not in short.casefold():
                icon = next((glyph for key, glyph in [('firefox', ''), ('chrome', ''),
                            ('chromium', ''), ('vlc', '󰕼'), ('mpv', '󰐹')]
                            if key in short.casefold()), '󰝚')
            metadata = self.properties.get('Metadata')
            metadata = metadata if isinstance(metadata, dict) else {}
            title = clean(metadata.get('xesam:title'))
            artists = metadata.get('xesam:artist', [])
            artist = ', '.join(filter(None, (clean(x) for x in artists))) if isinstance(artists, list) else ''
            album = clean(metadata.get('xesam:album'))
            status = self.properties.get('PlaybackStatus')
            state = status.lower() if status in ['Playing', 'Paused', 'Stopped'] else 'unknown'
            if title and self.owner:
                text = '<b>'+GLib.markup_escape_text(title)+'</b>'
                if artist:
                    text += ' <span alpha="80%">· '+GLib.markup_escape_text(artist)+'</span>'
            else:
                text = 'Carregando mídia' if self.loading else {'Playing': 'Mídia em reprodução', 'Paused': 'Player sem faixa', 'Stopped': 'Player parado'}.get(status, 'Estado de mídia indisponível')
                if not self.loading: state = 'empty'
            tip = GLib.markup_escape_text(short)+' · '+{'Playing': 'Reproduzindo', 'Paused': 'Pausado',
                    'Stopped': 'Parado'}.get(status, 'Aguardando estado MPRIS')
            if title: tip += '\n'+GLib.markup_escape_text(title)
            if artist: tip += '\nArtista: '+GLib.markup_escape_text(artist)
            if album: tip += '\nÁlbum: '+GLib.markup_escape_text(album)
            tip += '\nClique: abrir/focar player'
        return {'text': icon+'  '+text, 'class': [state, 'track' if self.name else 'placeholder',
                'controls' if any(v['text'] for v in self.controls().values()) else 'standalone'], 'tooltip': tip}


class Observer:
    def __init__(self, publish, write_target=None):
        self.publish, self.write_target = publish, write_target
        self.state = MediaState()
        self.pending = 0
        self.proxy = None
        self.proxy_signals = []
        self.request = None
        self.bound = None
        self.previous = None
        self.previous_target = None
        self.loading_timeout = 0
        self.alive = True
        self.order = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, FLAGS, None,
            NAME, PATH, 'com.github.altdesktop.playerctld', None)
        self.order_signals = [self.order.connect('notify::g-name-owner', self.select),
                              self.order.connect('g-properties-changed', self.select)]
        self.select()

    def schedule(self):
        if self.alive and not self.pending:
            self.pending = GLib.idle_add(self.emit)

    def emit(self):
        self.pending = 0
        if not self.alive: return False
        target = self.state.target()
        if self.write_target and target != self.previous_target:
            self.write_target(target)
            self.previous_target = target
        output = self.state.output()
        if output != self.previous or self.state.controls() != getattr(self, 'previous_controls', None):
            self.publish(output)
            self.previous = output
            self.previous_controls = self.state.controls()
        return False

    def detach(self):
        if self.request:
            self.request.cancel()
            self.request = None
        if self.proxy:
            for handler in self.proxy_signals: self.proxy.disconnect(handler)
        self.proxy, self.proxy_signals = None, []

    def select(self, *_):
        if not self.alive: return
        owner = self.order.get_name_owner()
        names = self.order.get_cached_property('PlayerNames')
        self.state.select(bool(owner), names.unpack() if names and owner else [])
        bound = (owner, self.state.name)
        if bound != self.bound:
            self.detach()
            self.bound = bound
            # A proxy restart with an unchanged player name is also a new epoch.
            self.state.epoch += 1
            self.state.owner, self.state.properties = None, {}
            self.state.loading = bool(self.state.name)
            if self.loading_timeout: GLib.source_remove(self.loading_timeout); self.loading_timeout = 0
            if self.state.name:
                self.loading_timeout = GLib.timeout_add(2000, self.loading_expired, self.state.epoch)
            epoch = self.state.epoch
            if self.state.name:
                self.request = Gio.Cancellable()
                Gio.DBusProxy.new_for_bus(Gio.BusType.SESSION, FLAGS, None,
                    self.state.name, PATH, PLAYER, self.request, self.ready, epoch)
        self.schedule()

    def loading_expired(self, epoch):
        self.loading_timeout = 0
        if self.alive and epoch == self.state.epoch:
            self.state.loading = False
            self.schedule()
        return False

    def ready(self, source, result, epoch):
        try: proxy = Gio.DBusProxy.new_for_bus_finish(result)
        except GLib.Error:
            if self.alive and epoch == self.state.epoch:
                self.state.loading = False
                self.schedule()
            return
        if not self.alive or epoch != self.state.epoch: return
        self.request = None
        self.proxy = proxy
        self.proxy_signals = [proxy.connect('g-properties-changed', self.changed, epoch),
                              proxy.connect('notify::g-name-owner', self.owner_changed, epoch)]
        self.refresh(proxy, epoch)

    def refresh(self, proxy, epoch):
        values = {key: value.unpack() for key in ['Metadata', 'PlaybackStatus', 'CanControl', 'CanGoNext', 'CanGoPrevious', 'CanPlay', 'CanPause']
                  if (value := proxy.get_cached_property(key)) is not None}
        if self.state.update(epoch, proxy.get_name_owner(), values): self.schedule()

    def changed(self, proxy, values, invalidated, epoch):
        keys = {'Metadata', 'PlaybackStatus', 'CanControl', 'CanGoNext', 'CanGoPrevious', 'CanPlay', 'CanPause'}
        changed = {key: value for key, value in values.unpack().items() if key in keys}
        invalidated = [key for key in invalidated if key in keys]
        if (changed or invalidated) and self.state.update(epoch, proxy.get_name_owner(), changed, invalidated):
            self.schedule()

    def owner_changed(self, proxy, spec, epoch):
        self.refresh(proxy, epoch)

    def close(self):
        self.alive = False
        if self.loading_timeout: GLib.source_remove(self.loading_timeout); self.loading_timeout = 0
        if self.pending: GLib.source_remove(self.pending); self.pending = 0
        self.detach()
        for handler in self.order_signals: self.order.disconnect(handler)


def main():
    from rice_common import write_json
    path = target_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    loop = GLib.MainLoop()
    previous_controls = None
    def publish(output):
        nonlocal previous_controls
        controls = observer.state.controls()
        if controls != previous_controls:
            for name, value in controls.items(): write_json(path.parent/('media-'+name+'.json'), value)
            parent = os.getppid()
            # Never signal a shell/test runner or an unprepared process.
            if (Path('/proc')/str(parent)/'comm').read_text().strip() == 'waybar':
                caught = next(line.split()[1] for line in (Path('/proc')/str(parent)/'status').read_text().splitlines() if line.startswith('SigCgt:'))
                sig = signal.SIGRTMIN+12
                if int(caught, 16) & (1 << (sig-1)): os.kill(parent, sig)
            previous_controls = controls
        print(json.dumps(output, ensure_ascii=False), flush=True)
    observer = Observer(publish, lambda target: write_json(path, target))
    def stop():
        loop.quit()
        return False
    handler = GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
    try: loop.run()
    finally:
        observer.close()
        if GLib.MainContext.default().find_source_by_id(handler): GLib.source_remove(handler)


if __name__ == '__main__':
    try: main()
    except (GLib.Error, OSError) as error:
        sys.exit('media-idle: '+str(error))
