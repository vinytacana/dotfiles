#!/usr/bin/python3
"""Validação sem iniciar compositor, barra ou bloqueador na sessão atual."""
import hashlib, json, shutil, subprocess, sys, tomllib
from pathlib import Path
home=Path.home(); root=home/'.config/niri'; failures=[]
def run(name,args):
    result=subprocess.run(args,text=True,capture_output=True)
    print(f'{name}: {"OK" if result.returncode == 0 else "FALHOU"}')
    if result.returncode:
        failures.append(name)
        print(result.stderr.strip())
for name in ['niri','waybar','fuzzel','mako','swaybg','swaylock','swayidle','xwayland-satellite',
             'alacritty','starship','zsh','btop','nautilus','wpctl','nmcli','bluetoothctl','wl-copy','wl-paste','brightnessctl']:
    if not shutil.which(name): failures.append(name); print(f'AUSENTE: {name}')
if shutil.which('niri'): run('Niri', ['niri','validate','--config',str(root/'config.kdl')])
if shutil.which('fuzzel'): run('Fuzzel', ['fuzzel','--check-config','--config',str(root/'fuzzel.ini')])
bars=json.loads((root/'waybar.jsonc').read_text())
if [bar.get('name') for bar in bars] != ['top','dock']:
    failures.append('Waybar bars'); print('Waybar bars: FALHOU')
else: print('Waybar JSON (top + dock): OK')
try:
    import gi
    gi.require_version('Gtk','3.0')
    from gi.repository import Gtk
    css=Gtk.CssProvider(); css.load_from_path(str(root/'waybar.css'))
    print('Waybar GTK3 CSS: OK')
    css.load_from_path(str(root/'rice-ui.css')); print('Rice UI GTK3 CSS: OK')
    gi.require_version('GtkLayerShell','0.1')
    from gi.repository import GtkLayerShell
    print('GTK layer-shell: OK')
except Exception as exc:
    failures.append('CSS'); print(exc)
for f in [home/'.config/alacritty/alacritty.toml',home/'.config/alacritty/niri.toml']:
    tomllib.loads(f.read_text())
print('Alacritty TOML: OK')
run('Alacritty parser', ['alacritty','migrate','--dry-run','--silent','--config-file',str(home/'.config/alacritty/niri.toml')])
for name in ['lock','idle','mako-session','settings-hub']: run(name,['sh','-n',str(root/'scripts'/name)])
for name in ['wallpaper-session']: run(name,['sh','-n',str(root/'scripts'/name)])
for name in ['dock-app','dock-mode','rice-ui','rice_common.py','rice_osd.py','mocha-osd','rice_bar.py','rice_recovery.py','waybar-recover','waybar-diagnose','gtk3-app','settings-window','wallpaper-manager','waybar-session','notifications','notification-server','notification-prune','clipboard-store','clipboard-control','launcher-index','rice-open','rice-rollback','rice_widgets.py','rice_controls.py','rice_panels.py','rice_clipboard.py','rice_search.py','rice_launcher.py','lockscreen','rice_power.py','waybar-preset','waybar_presets.py','media-player','media-idle','rice_control_center.py','control-indicator']:
    try:
        compile((root/'scripts'/name).read_text(),str(root/'scripts'/name),'exec')
        print(f'{name}: OK')
    except SyntaxError as exc:
        failures.append(name); print(exc)
for name in ['gnome-control-center','zenity','magick','pavucontrol','nm-connection-editor','blueman-manager','gnome-tweaks']:
    if not shutil.which(name): failures.append(name); print(f'AUSENTE: {name}')
if shutil.which('desktop-file-validate'):
    run('Launchers', ['desktop-file-validate',str(home/'.local/share/applications/niri-settings.desktop'),str(home/'.local/share/applications/niri-gnome-settings.desktop')])
for p in [Path('/usr/share/wayland-sessions/niri.desktop'),Path('/usr/share/wayland-sessions/gnome.desktop'),Path('/usr/libexec/polkit-mate-authentication-agent-1')]:
    if not p.exists(): failures.append(str(p)); print(f'AUSENTE: {p}')
for name in ['clipboard-defaults.json','dock-defaults.json','swaync.json']:
    json.loads((root/name).read_text())
print('V4 JSON: OK')
run('Waybar presets JSON/GTK3/selection',[sys.executable,str(root/'tests/test_waybar_presets.py')])
run('Waybar state/serialization/diagnostics',[sys.executable,str(root/'tests/test_bar_lifecycle.py')])
run('Waybar bounded event recovery',[sys.executable,str(root/'tests/test_waybar_recovery.py')])
run('Mocha OSD GTK/events/privacy/lifecycle',[sys.executable,str(root/'tests/test_osd.py')])
run('Control center GTK/backends/lifecycle',[sys.executable,str(root/'tests/test_control_center.py')])
run('Calendar GTK layout/navigation/lifecycle',[sys.executable,str(root/'tests/test_calendar.py')])
if shutil.which('gtklock'):
    run('Lockscreen GTK3 (sem bloquear)',[str(root/'scripts/lock'),'--check'])
run('Lockscreen cache/fallback regressions',[sys.executable,str(root/'tests/test_lockscreen.py')])
run('Power menu confirmations (execução simulada)',[sys.executable,str(root/'tests/test_power.py')])
run('V4 privacy/parser/index regressions',[sys.executable,str(root/'tests/test_v4.py')])
if shutil.which('swaync'):
    run('SwayNC GTK4 CSS',[sys.executable,'-c',"import gi,sys;gi.require_version('Gtk','4.0');from gi.repository import Gtk;p=Gtk.CssProvider();errors=[];p.connect('parsing-error',lambda _,section,error:errors.append(str(error)));p.load_from_path(sys.argv[1]);print('\\n'.join(errors));sys.exit(bool(errors))",str(root/'swaync.css')])
    run('SwayNC schema',[sys.executable,'-c',"import json,jsonschema,sys;jsonschema.validate(json.load(open(sys.argv[1])),json.load(open('/etc/xdg/swaync/configSchema.json')))",str(root/'swaync.json')])
else:
    failures.append('SwayNC');print('AUSENTE: SwayNotificationCenter (repositórios Fedora)')
units=sorted((home/'.config/systemd/user').glob('niri-rice*'))
run('Rice systemd units',['systemd-analyze','--user','verify',*[str(p) for p in units if p.is_file()]])
repo=Path(__file__).resolve().parents[4]
if (repo/'.git').exists():
    result=subprocess.run(['stow','--simulate','--no-folding','-t',str(home),'niri'],cwd=repo,capture_output=True,text=True)
    print('Stow simulation: '+('OK' if result.returncode==0 else 'FALHOU'))
    if result.returncode:failures.append('Stow');print(result.stderr)
print('Logout/login GNOME, suspensão e autenticação de bloqueio: não executados automaticamente.')
sys.exit(bool(failures))
