#!/usr/bin/python3
"""Generate both bars and favorite icon CSS; exec exactly one Waybar process."""
import sys
sys.dont_write_bytecode = True
import json
import os
from pathlib import Path
import shlex
import subprocess
from rice_common import ROOT, STATE, favorites, desktop, icon_file, appearance
from waybar_presets import current, render
from rice_bar import atomic_text

# GTK image decoders may own sandbox children and GLib reaper threads. Keep
# those in a short-lived helper: execing Waybar must not discard their reapers.
if sys.argv[1:] == ['--icons']:
    identities = json.load(sys.stdin)
    if not isinstance(identities, list) or any(not isinstance(item, str) for item in identities):
        raise ValueError('Ícones exigem uma lista de arquivos desktop')
    icons = {}
    for identity in identities:
        app = desktop(identity)
        if app:
            icons[identity] = icon_file(app)
    print(json.dumps(icons))
    raise SystemExit(0)

os.environ['LC_TIME'] = 'pt_BR.UTF-8'
os.environ['LANGUAGE'] = 'pt_BR'
runtime = Path(os.environ['XDG_RUNTIME_DIR']) / 'niri-rice'
runtime.mkdir(mode=0o700, exist_ok=True)
preset = current()
bars, css = render(preset)
dock_enabled = not (STATE / 'dock-disabled').exists()
# A disabled dock must not parse favorites or start GTK image decoders.
items = favorites() if dock_enabled else []
icon_paths = {}
if items:
    decoded = subprocess.run([sys.executable, str(Path(__file__).resolve()), '--icons'],
                             input=json.dumps(items), stdout=subprocess.PIPE, text=True,
                             check=True, timeout=15)
    icon_paths = json.loads(decoded.stdout)
dock = next(bar for bar in bars if bar['name'] == 'dock')
dock['modules-center'] = []
for number, identity in enumerate(items):
    app = desktop(identity)
    if app is None:
        continue
    name = f'custom/favorite-{number}'
    action = shlex.quote(str(ROOT / 'scripts/dock-app')) + ' ' + shlex.quote(identity)
    dock['modules-center'].append(name)
    dock[name] = {'exec': action + ' status', 'return-type': 'json', 'interval': 5,
                  'on-click': action + ' open', 'on-click-right':
                  shlex.quote(str(ROOT / 'scripts/settings-hub')) + ' favorites ' + shlex.quote(identity)}
    icon = icon_paths.get(identity)
    if icon:
        css += f'\n#custom-favorite-{number} {{ background-image: url({json.dumps(Path(icon).as_uri())}); }}\n'
dock['modules-center'].append('custom/dock-edit')
dock['custom/dock-edit'] = {'format': '＋', 'tooltip-format': 'Gerenciar favoritos',
                           'on-click': str(ROOT / 'scripts/settings-hub') + ' favorites'}
dock['width'] = 54 * (len(dock['modules-center'])) + 24
prefs = appearance()
opacity = min(1.0, max(0.85, float(prefs['opacity'])))
if prefs['style'] == 'light' and preset == 'original':
    for old, new in {'#cdd6f4':'#4c4f69', '#bac2de':'#5c5f77', '#a6adc8':'#6c6f85', '#cba6f7':'#8839ef',
                     '#313244':'#ccd0da', '#45475a':'#bcc0cc', '#1e1e2e':'#eff1f5',
                     '30, 30, 46':'239, 241, 245', '24, 24, 37':'230, 233, 239'}.items():
        css = css.replace(old, new)
css = css.replace('0.94)', f'{opacity:.2f})')
if not dock_enabled:
    bars = [bar for bar in bars if bar.get('name') != 'dock']
atomic_text(runtime / 'waybar.json', json.dumps(bars))
atomic_text(runtime / 'waybar.css', css)
print('waybar-session: preset='+preset+' bars='+','.join(bar['name'] for bar in bars), flush=True)
os.execv('/usr/bin/waybar', ['waybar', '-c', str(runtime / 'waybar.json'), '-s', str(runtime / 'waybar.css')])
