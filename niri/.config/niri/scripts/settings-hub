#!/bin/sh
# The single-instance UI lives outside Waybar's cgroup so dock updates keep it open.
set -eu
if [ "$#" -eq 0 ]; then set -- settings; fi
exec systemd-run --user --quiet --collect --property=ExitType=cgroup \
    --property=PartOf=graphical-session.target -- "$HOME/.config/niri/scripts/rice-ui" "$@"
