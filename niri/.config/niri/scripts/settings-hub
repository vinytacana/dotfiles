#!/usr/bin/python3
"""Niri settings menu; GNOME desktop identity is process local."""
import os
import subprocess
from pathlib import Path

home = Path.home()
wallpaper = str(home / ".config/niri/scripts/wallpaper-manager")
settings = str(home / ".config/niri/scripts/settings-window")
options = [
    ("Configurações do GNOME", [settings], False),
    ("Áudio", ["pavucontrol"], False),
    ("Rede", ["nm-connection-editor"], False),
    ("Bluetooth", ["blueman-manager"], False),
    ("Aparência GTK", ["gnome-tweaks"], True),
    ("Energia", [settings, "power"], False),
    ("Monitores", [settings, "display"], False),
    ("Wallpaper do Niri", [wallpaper, "choose"], False),
]
picker = subprocess.run(
    ["fuzzel", "--config", str(home / ".config/niri/fuzzel.ini"), "--dmenu", "--prompt", "Configurações > "],
    input="\n".join(label for label, _, _ in options) + "\n", text=True, capture_output=True,
)
if picker.returncode:
    raise SystemExit(0)
selected = picker.stdout.strip()
for label, command, gnome_identity in options:
    if selected == label:
        env = os.environ.copy()
        if gnome_identity:
            env["XDG_CURRENT_DESKTOP"] = "GNOME"
        subprocess.Popen(command, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        break
