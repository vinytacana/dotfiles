#!/usr/bin/python3
"""Theme selection without a daemon: rice-theme set {mocha,orbit}."""
import argparse,os,sys
from pathlib import Path
sys.dont_write_bytecode=True
import rice_theme as theme
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('action',choices=['current','list','set','check','generate','launcher'])
parser.add_argument('name',nargs='?',choices=['mocha','orbit'])
args=parser.parse_args()
try:
    if args.action=='current':print(theme.current())
    elif args.action=='list':
        for name,value in theme.palettes().items():print(name+' · '+value['label'])
    elif args.action=='check':
        for name in theme.palettes():theme.validate_bundle(theme.bundle(name))
        print('Mocha/Orbit: CSS GTK3/GTK4, Niri e TOML OK.')
    elif args.action=='launcher':
        path=theme.GENERATED/'fuzzel.ini'
        os.execvp('fuzzel',['fuzzel','--config',str(path if path.exists() else theme.ROOT/'fuzzel.ini')])
    else:
        name=args.name or theme.current()
        print(theme.apply(name,live=args.action=='set'))
except Exception as error:raise SystemExit('rice-theme: '+str(error))
