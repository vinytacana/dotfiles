#!/usr/bin/python3
"""Receipt-based V4 -> V3 restore. Default is simulation; never overwrites later edits."""
import argparse,hashlib,json,os,subprocess,tarfile
from pathlib import Path

def record(path):
    if path.is_symlink():return {'link':os.readlink(path)}
    if not path.is_file():return None
    return {'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'mode':path.stat().st_mode&0o777}

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('backup',type=Path);parser.add_argument('--apply',action='store_true')
    args=parser.parse_args();backup=args.backup.expanduser().resolve()
    receipt=json.loads((backup/'receipt.json').read_text());repo=Path(receipt['repository'])
    archive=backup/'v3.tar.gz'
    if hashlib.sha256(archive.read_bytes()).hexdigest()!=receipt['archive_sha256']:raise SystemExit('Backup archive checksum mismatch; stopped.')
    conflicts=[]
    for name,entry in receipt['files'].items():
        current=record(repo/name)
        if current not in [entry['installed'],entry['before']]:conflicts.append(str(repo/name))
    for target,expected in receipt['new_links'].items():
        path=Path(target)
        if (path.exists() or path.is_symlink()) and (not path.is_symlink() or os.readlink(path)!=expected):conflicts.append(target)
    if conflicts:raise SystemExit('Later changes detected. Preserve and review these paths before restoring:\n'+'\n'.join(conflicts))
    print('Repository:',repo)
    print('Restore V3 files:',sum(entry['before'] is not None for entry in receipt['files'].values()))
    print('Remove V4 files:',sum(entry['before'] is None for entry in receipt['files'].values()))
    print('Remove new Stow links:',len(receipt['new_links']))
    print('Stop V4 services and briefly stop Waybar; restore Mako and Waybar in Niri.')
    print('Keep favorites, wallpaper, GNOME preferences and installed packages.')
    if not args.apply:print('SIMULATION ONLY. Add --apply to restore.');return
    niri='niri' in os.environ.get('XDG_CURRENT_DESKTOP','').split(':')
    if niri:subprocess.run(['systemctl','--user','stop','niri-rice-bar.service',*receipt['services']],check=True)
    # Touch only paths whose installed hashes matched. Never extract the whole archive.
    with tarfile.open(archive,'r:gz') as saved:
        for name,entry in receipt['files'].items():
            path=repo/name
            if entry['before'] is None:
                if path.is_file() or path.is_symlink():path.unlink()
                continue
            member=saved.getmember(name);path.parent.mkdir(parents=True,exist_ok=True)
            if path.is_symlink():path.unlink()
            if member.issym():os.symlink(member.linkname,path)
            elif member.isfile():
                path.write_bytes(saved.extractfile(member).read());path.chmod(member.mode)
            else:raise RuntimeError('Unsupported archive member: '+name)
    for target in receipt['new_links']:
        path=Path(target)
        if path.is_symlink():path.unlink()
    # SwayNC remains installed. Select the original Mako activator explicitly so
    # package provider ordering cannot silently launch SwayNC after rollback.
    source=repo/'niri/.local/share/dbus-1/services/org.freedesktop.Notifications.service'
    source.parent.mkdir(parents=True,exist_ok=True)
    source.write_text('[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/bin/mako\nSystemdService=mako.service\n')
    subprocess.run(['stow','--simulate','--no-folding','-t',str(Path.home()),'niri'],cwd=repo,check=True)
    subprocess.run(['stow','--no-folding','-t',str(Path.home()),'niri'],cwd=repo,check=True)
    subprocess.run(['niri','validate','--config',str(repo/'niri/.config/niri/config.kdl')],check=True)
    subprocess.run(['systemctl','--user','daemon-reload'],check=True)
    subprocess.run(['gdbus','call','--session','--dest','org.freedesktop.DBus','--object-path','/org/freedesktop/DBus','--method','org.freedesktop.DBus.ReloadConfig'],check=True)
    if niri:
        subprocess.run(['systemctl','--user','start','mako.service'],check=True)
        subprocess.run(['systemctl','--user','restart','niri-rice-bar.service'],check=True)
    print('V3 restored. The Mako activation selector remains Stow-managed because SwayNC is still installed.')
if __name__=='__main__':main()
