#!/bin/sh
set -eu
exec swayidle -w \
  timeout 300 "$HOME/.config/niri/scripts/lock" \
  timeout 600 'niri msg action power-off-monitors' \
  resume 'niri msg action power-on-monitors' \
  before-sleep "$HOME/.config/niri/scripts/lock" \
  after-resume "$HOME/.config/niri/scripts/waybar-diagnose resume" \
  lock "$HOME/.config/niri/scripts/lock"
