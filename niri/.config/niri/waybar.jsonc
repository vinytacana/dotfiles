[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 6,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
      "custom/system",
      "niri/workspaces",
      "group/resources",
      "niri/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "group/media",
      "group/connectivity",
      "tray",
      "group/session"
    ],
    "niri/workspaces": {
      "format": "{value}",
      "all-outputs": false,
      "disable-click": false,
      "disable-markup": true
    },
    "niri/window": {
      "format": "{}",
      "max-length": 16
    },
    "clock": {
      "format": "{:%d/%m/%Y  ·  %H:%M}",
      "tooltip-format": "<big>{:%m/%Y}</big>\n<tt>{calendar}</tt>\nClique para abrir o calendário",
      "locale": "pt_BR.UTF-8",
      "on-click": "~/.config/niri/scripts/settings-hub calendar"
    },
    "cpu": {
      "format": "CPU {usage}%",
      "interval": 5,
      "tooltip-format": "Processador · {usage}% em uso",
      "min-length": 6,
      "max-length": 8
    },
    "memory": {
      "format": "RAM {percentage}%",
      "interval": 5,
      "tooltip-format": "{used:.1f} / {total:.1f} GiB",
      "min-length": 6,
      "max-length": 8
    },
    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭",
      "tooltip-format": "{ifname} · {essid}\nSinal: {signalStrength}%\nClique: seção Wi-Fi",
      "on-click": "~/.config/niri/scripts/settings-hub control wifi",
      "max-length": 3
    },
    "pulseaudio": {
      "format": "<span font_family=\"Font Awesome 6 Free\" weight=\"900\" size=\"small\"></span>\u2002{volume}%",
      "format-muted": "󰝟",
      "on-click": "~/.config/niri/scripts/settings-hub control",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "scroll-step": 5,
      "max-volume": 100,
      "tooltip-format": "Volume: {volume}%\nClique: central de controle\nBotão direito: silenciar",
      "max-length": 8
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "",
      "format-off": "",
      "on-click": "~/.config/niri/scripts/settings-hub control bluetooth",
      "tooltip-format": "Bluetooth · {status}\nClique: seção Bluetooth"
    },
    "battery": {
      "bat": "BAT0",
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "states": {
        "warning": 25,
        "critical": 10
      },
      "interval": 30,
      "on-click": "~/.config/niri/scripts/settings-hub control battery",
      "format-icons": [
        "󰁺",
        "󰁼",
        "󰁿",
        "󰂁",
        "󰁹"
      ],
      "tooltip-format": "Bateria: {capacity}% · {timeTo}",
      "max-length": 8
    },
    "custom/notifications": {
      "exec": "~/.config/niri/scripts/notifications",
      "return-type": "json",
      "interval": 5,
      "on-click": "~/.config/niri/scripts/notifications open",
      "on-click-right": "~/.config/niri/scripts/notifications dnd",
      "format": "{icon}",
      "format-icons": {
        "empty": "󰂜",
        "pending": "󰂚",
        "paused": "󰂛",
        "unavailable": "󰂛"
      }
    },
    "custom/power": {
      "format": "⏻",
      "tooltip-format": "Menu de energia · Super+Esc",
      "on-click": "~/.config/niri/scripts/settings-hub power"
    },
    "tray": {
      "spacing": 6,
      "icon-size": 16
    },
    "fixed-center": true,
    "custom/system": {
      "format": "",
      "tooltip-format": "Fedora · Aplicativos\nBotão direito: Configurações",
      "on-click": "systemd-run --user --quiet --collect --property=ExitType=cgroup --property=PartOf=graphical-session.target -- fuzzel --config ~/.config/niri/fuzzel.ini",
      "on-click-right": "~/.config/niri/scripts/settings-hub"
    },
    "group/resources": {
      "orientation": "horizontal",
      "modules": [
        "cpu",
        "memory"
      ]
    },
    "group/connectivity": {
      "orientation": "horizontal",
      "modules": [
        "network",
        "pulseaudio",
        "bluetooth",
        "battery"
      ]
    },
    "group/session": {
      "orientation": "horizontal",
      "modules": [
        "custom/notifications",
        "custom/control",
        "custom/power"
      ]
    },
    "group/media": {
      "orientation": "horizontal",
      "modules": [
        "custom/media-idle",
        "mpris#track",
        "mpris#previous",
        "mpris#play",
        "mpris#next"
      ]
    },
    "mpris#track": {
      "player": "playerctld",
      "interval": 1,
      "player-icons": {
        "default": "󰝚",
        "spotify": "<span foreground=\"#1db954\" size=\"large\"></span>",
        "chromium": "",
        "firefox": "",
        "vlc": "󰕼",
        "mpv": "󰐹"
      },
      "title-len": 24,
      "artist-len": 18,
      "tooltip-format": "{player} · {status}\n{title}\nArtista: {artist}\nÁlbum: {album}\nClique: abrir/focar player",
      "max-length": 26,
      "format": "{player_icon}  <b>{title}</b> <span foreground=\"#a6adc8\">· {artist}</span>",
      "on-click": "~/.config/niri/scripts/media-player",
      "on-click-right": "~/.config/niri/scripts/media-player",
      "min-length": 26,
      "align": 0.0,
      "enable-tooltip-len-limits": false
    },
    "mpris#previous": {
      "player": "playerctld",
      "interval": 1,
      "format": "󰒮",
      "max-length": 2,
      "on-click": "playerctl --player=playerctld previous",
      "status-icons": {
        "playing": "󰏤",
        "paused": "󰐊",
        "stopped": "󰐊"
      },
      "tooltip-format": "Faixa anterior\n{player}: {title}\n{artist}",
      "min-length": 2,
      "align": 0.5
    },
    "mpris#play": {
      "player": "playerctld",
      "interval": 1,
      "format": "{status_icon}",
      "max-length": 2,
      "on-click": "playerctl --player=playerctld play-pause",
      "status-icons": {
        "playing": "󰏤",
        "paused": "󰐊",
        "stopped": "󰐊"
      },
      "tooltip-format": "Reproduzir / pausar\n{player}: {title}\n{artist}",
      "min-length": 2,
      "align": 0.5
    },
    "mpris#next": {
      "player": "playerctld",
      "interval": 1,
      "format": "󰒭",
      "max-length": 2,
      "on-click": "playerctl --player=playerctld next",
      "status-icons": {
        "playing": "󰏤",
        "paused": "󰐊",
        "stopped": "󰐊"
      },
      "tooltip-format": "Próxima faixa\n{player}: {title}\n{artist}",
      "min-length": 2,
      "align": 0.5
    },
    "custom/media-idle": {
      "exec": "~/.config/niri/scripts/media-idle",
      "return-type": "json",
      "format": "{text}",
      "hide-empty-text": true,
      "restart-interval": 3,
      "exec-on-event": false,
      "on-click": "~/.config/niri/scripts/media-player",
      "on-click-right": "~/.config/niri/scripts/media-player",
      "min-length": 18,
      "max-length": 18,
      "align": 0.0
    },
    "custom/control": {
      "exec": "~/.config/niri/scripts/control-indicator",
      "return-type": "json",
      "format": "{text}",
      "restart-interval": 3,
      "exec-on-event": false,
      "on-click": "~/.config/niri/scripts/settings-hub control"
    }
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "width": 430,
    "height": 56,
    "spacing": 0,
    "margin-bottom": 12,
    "exclusive": false,
    "passthrough": false,
    "modules-center": []
  }
]
