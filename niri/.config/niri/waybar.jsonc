[
{
  "name": "top",
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "bluetooth",
    "battery",
    "custom/notifications",
    "custom/settings",
    "custom/wallpaper",
    "tray"
  ],
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": false
  },
  "niri/window": {
    "format": "{}",
    "max-length": 38
  },
  "clock": {
    "format": "{:%a %d/%m  %H:%M}",
    "tooltip-format": "{:%A, %d de %B de %Y}"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:.1f} / {total:.1f} GiB"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname} · {essid}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Mudo",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 100
  },
  "bluetooth": {
    "format": "BT {status}",
    "format-disabled": "",
    "format-off": "BT off",
    "on-click": "blueman-manager"
  },
  "battery": {
    "bat": "BAT0",
    "format": "BAT {capacity}%",
    "format-charging": "+ {capacity}%",
    "states": {
      "warning": 25,
      "critical": 10
    },
    "interval": 30
  },
  "custom/notifications": {
    "exec": "~/.config/niri/scripts/notifications",
    "return-type": "json",
    "interval": 5,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss -a"
  },
  "custom/settings": {
    "format": "",
    "tooltip-format": "Configurações do sistema",
    "on-click": "~/.config/niri/scripts/settings-hub"
  },
  "custom/wallpaper": {
    "format": "",
    "tooltip-format": "Escolher wallpaper",
    "on-click": "~/.config/niri/scripts/wallpaper-manager choose"
  },
  "tray": {
    "spacing": 8,
    "icon-size": 16
  }
},
{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  "width": 430,
  "height": 54,
  "spacing": 8,
  "margin-bottom": 12,
  "exclusive": false,
  "passthrough": false,
  "modules-center": ["custom/dock-terminal", "custom/dock-browser", "custom/dock-code", "custom/dock-files", "custom/dock-settings"],
  "custom/dock-terminal": { "exec": "~/.config/niri/scripts/dock-app terminal status", "return-type": "json", "interval": 5, "on-click": "~/.config/niri/scripts/dock-app terminal open" },
  "custom/dock-browser": { "exec": "~/.config/niri/scripts/dock-app browser status", "return-type": "json", "interval": 5, "on-click": "~/.config/niri/scripts/dock-app browser open" },
  "custom/dock-code": { "exec": "~/.config/niri/scripts/dock-app code status", "return-type": "json", "interval": 5, "on-click": "~/.config/niri/scripts/dock-app code open" },
  "custom/dock-files": { "exec": "~/.config/niri/scripts/dock-app files status", "return-type": "json", "interval": 5, "on-click": "~/.config/niri/scripts/dock-app files open" },
  "custom/dock-settings": { "exec": "~/.config/niri/scripts/dock-app settings status", "return-type": "json", "interval": 5, "on-click": "~/.config/niri/scripts/dock-app settings open", "on-click-right": "~/.config/niri/scripts/settings-hub" }
}
]
