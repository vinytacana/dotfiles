[Unit]
Description=Niri rice: blurred wallpaper cache for the lockscreen
PartOf=niri-rice.target graphical-session.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
Type=oneshot
ExecStart=%h/.config/niri/scripts/lockscreen background
UMask=0077
Nice=10
TimeoutStartSec=45
