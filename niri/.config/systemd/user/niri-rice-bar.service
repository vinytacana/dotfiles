[Unit]
Description=Niri rice: bar
PartOf=niri-rice.target graphical-session.target
After=graphical-session.target
Wants=niri-rice-media.service
After=niri-rice-media.service
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
StartLimitIntervalSec=30s
StartLimitBurst=20
[Service]
ExecStart=%h/.config/niri/scripts/waybar-session
# Opt-in snapshots expire automatically; runs only when the unit stops.
ExecStopPost=-%h/.config/niri/scripts/waybar-diagnose stop
Restart=on-failure
RestartSec=3
